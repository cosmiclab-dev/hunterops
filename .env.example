# ---------------------------------------------------------------------------
# HunterOps v2 environment variables. Copy to .env for local dev and add the
# same keys in Vercel: Project > Settings > Environment Variables.
# Never commit .env.
# ---------------------------------------------------------------------------

# Neon: pooled string (host has "-pooler") for the app, direct string for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Required. Encrypts API keys and the Gmail app password before they are stored,
# and signs the login cookie. 32+ random characters:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
APP_SECRET=

# Required once deployed. The password you type on the login screen.
APP_PASSWORD=

# Required for the daily scan. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Optional. API keys can be entered in Settings instead (preferred); these are fallbacks.
LLM_PROVIDER=opencode
LLM_MODEL=deepseek-v4.1-flash
OPENCODE_API_KEY=
# OPENAI_API_KEY= ANTHROPIC_API_KEY= GEMINI_API_KEY= OPENROUTER_API_KEY= GROQ_API_KEY=
# CUSTOM_LLM_API_KEY= LLM_BASE_URL=

# Optional. Gmail can also be set in Settings.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_NAME=
