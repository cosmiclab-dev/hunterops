# ---------------------------------------------------------------------------
# HunterOps environment variables
# Copy to .env for local `netlify dev`, and add the same keys in
# Netlify: Site configuration > Environment variables.
# Never commit .env.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (Neon console > Connect). Either the pooled
# (-pooler) or direct string works: the HTTP driver sends each query over HTTPS.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# OpenCode Go base URL for OpenAI-compatible models (DeepSeek, GLM, Kimi...).
# Optional: this is the default. The function appends /chat/completions.
OPENCODE_API_URL=https://opencode.ai/inference/go/openai/v1

# Optional fallback key. You can instead paste your key in the app's Settings
# (gear icon); a key entered there is used first and never stored on the server.
# Sent upstream as "Authorization: Bearer <key>".
OPENCODE_API_KEY=

# Optional. Default model when the request doesn't name one.
OPENCODE_MODEL=deepseek-v4.1-flash

# Optional. Models allowed when the server key above is used. With a key from
# Settings, any model id is allowed (it spends that key's own quota).
OPENCODE_ALLOWED_MODELS=deepseek-v4.1-flash,deepseek-v4-pro

# Optional but strongly recommended once deployed. Any long random string.
# When set, every /api call must send it (the app asks once and remembers it
# in your browser). Without it, anyone who finds your URL can read your
# pipeline and spend your OpenCode quota.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
APP_ACCESS_TOKEN=
