{
  "name": "hunterops",
  "version": "2.0.0",
  "private": true,
  "description": "HunterOps v2: job search cockpit on Next.js 14, Prisma and Neon.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "e2e": "bash e2e/e2e.sh",
    "db:migrate": "prisma migrate deploy",
    "test:live": "vitest run -c vitest.live.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.0",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "next": "^14.2.35",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
